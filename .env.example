# reachyn — config compartilhada (NUNCA commitar .env real)
# Provedores de IA são plugáveis por variável de ambiente (BYOK).
# Os nomes das chaves abaixo são o contrato de fio com o engine — não renomeie.

# Postgres (console + engine; RLS por tenant)
POSTGRES_DB=reachyn
POSTGRES_USER=reachyn
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://reachyn:change-me@postgres:5432/reachyn
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reachyn
# RUNTIME conecta como reachyn_app (sem bypass de RLS).
DB_USERNAME=reachyn_app
DB_PASSWORD=change-me-app
DB_APP_PASSWORD=change-me-app

# console (Laravel)
APP_KEY=
APP_URL=https://app.example.com
# STUDIO_URL: em prod (mesma origem) pode omitir. Em dev: http://localhost:3000
# STUDIO_URL=https://app.example.com
APP_ENV=production
APP_DEBUG=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
FRONTEND_URL=https://app.example.com

# engine (Go) — chaves BYOK (slugs de fio; comentários sem marca)
PORT=8080
TAVILY_API_KEY=
JINA_API_KEY=
OLLAMA_API_KEY=
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
MAGNIFIC_API_KEY=

# cli-bridge opcional no host (vazio = desligado)
CLI_BRIDGE_URL=
CLI_BRIDGE_TOKEN=
CLI_BRIDGE_MAC_URL=
CLI_BRIDGE_MAC_TOKEN=
CLI_TEXT_CLI=codex
CLI_TEXT_CLI_FAST=mmx
CLI_BRIDGE_CLIPES=2

# Token engine⇄console (/v1/admin/*). Gerar: openssl rand -hex 32
ENGINE_ADMIN_TOKEN=
CONSOLE_INTERNAL_URL=http://console:8000
# Token console⇄web (compositor). Gerar: openssl rand -hex 32
COMPOSE_TOKEN=
WEB_INTERNAL_URL=http://web:3210

# mídia (S3-compat + ffmpeg)
MEDIA_FFMPEG_URL=http://ffmpeg-service:7788
FFMPEG_SERVICE_TOKEN=
MEDIA_S3_ENDPOINT=http://scality-s3:8000
MEDIA_S3_BUCKET=public
MEDIA_S3_PUBLIC_BASE=https://s3.example.com
S3_KEY=
S3_SECRET=

# estúdio 3D opcional (vazio = desligado)
BLENDER_BRIDGE_URL=
BLENDER_BRIDGE_TOKEN=

# publicação social (BYOK)
ZERNIO_API_KEY=

# e-mail
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=nao-responda@example.com
MAIL_FROM_NAME=Reachyn

# cadastro self-service (off por padrão)
REGISTRATION_ENABLED=false
