# ───────── reachyn-mono — config compartilhada (NUNCA commitar .env real) ─────────
# Cada app lê o que precisa; aqui fica a fonte única de verdade dos segredos.

# Postgres (compartilhado console + engine; RLS por tenant)
POSTGRES_DB=reachyn
POSTGRES_USER=reachyn
POSTGRES_PASSWORD=change-me
# engine (Go) lê DATABASE_URL nativamente:
DATABASE_URL=postgres://reachyn:change-me@postgres:5432/reachyn
# console/worker/scheduler (Laravel) NÃO usam DATABASE_URL — precisam destas DB_* explícitas
# (mesmos valores das POSTGRES_* acima; sem elas o Laravel cai no sqlite default e o worker crasha):
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reachyn
DB_USERNAME=reachyn
DB_PASSWORD=change-me
# Windmill: DB dedicado no MESMO postgres (dados copiados do windmill-skrh antigo)
WINDMILL_DATABASE_URL=postgres://windmill:change-me@postgres:5432/windmill?sslmode=disable
WINDMILL_BASE_URL=https://windmill.example.com

# ── console (Laravel) ──
APP_KEY=
APP_URL=https://app.example.com
# ───────── AUD-006 + AUD-031: hardening de sessão/ambiente (valores de PROD) ─────────
# ⚠️ Em produção APP_DEBUG DEVE ser false (true vaza stack traces/segredos em telas de erro).
APP_ENV=production
APP_DEBUG=false
# Cookie de sessão só por HTTPS + SameSite (mitiga roubo de sessão / CSRF cross-site).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com
# Sanctum stateful (cookie de sessão same-origin para o web/Studio) + URL do front.
SANCTUM_STATEFUL_DOMAINS=app.example.com
FRONTEND_URL=https://app.example.com

# ── engine (Go) — chaves dos provedores de IA (nomes de var = contrato do engine) ──
# Os NOMES das vars são lidos pelo engine; os VALORES são segredos (ficam fora do git).
# White-label: nada de nome de provedor em copy/UI; aqui são só os campos de credencial.
PORT=8080
# Pesquisa (BYOK / sistema): preencha as chaves dos provedores de busca contratados.
SEARCH_PRIMARY_API_KEY=
SEARCH_ALT_API_KEY=
RERANK_API_KEY=
SCRAPER_API_KEY=
# Geração: texto/imagem (primário e alternativo), mídia (vídeo fila + i2i) e voz.
TEXT_ALT_API_KEY=
TEXT_API_KEY=
SPEECH_API_KEY=
MEDIA_API_KEY=
# Chave do provedor de vídeo premium.
PREMIUM_VIDEO_API_KEY=

# ── WHITE-LABEL: bases/modelos/endpoints/headers dos provedores de IA ──
# Nenhuma URL real nem nome de modelo vive no código — TUDO vem destas vars. Sem default
# revelador: preencha com os endpoints/modelos reais SÓ aqui (fora do git). Placeholders
# genéricos abaixo só ilustram o formato; troque pelos valores reais.

# Texto (LLM) — base SEM path; o engine concatena o path. + modelo.
TEXT_BASE_URL=https://text-provider.example
TEXT_MODEL=text-model
TEXT_ALT_BASE_URL=https://text-alt-provider.example
TEXT_ALT_MODEL=text-alt-model

# Imagem — base+modelo do provedor primário (t2i) + endpoints completos do gerador
# alternativo (t2i) e do editor (i2i).
IMAGE_BASE_URL=https://image-provider.example
IMAGE_MODEL=image-model
IMAGE_GEN_URL=https://image-gen-provider.example/generate
IMAGE_EDIT_URL=https://image-edit-provider.example/edit

# Vídeo (fila) — endpoints completos t2v/i2v por slot opaco (video-a/b/c).
VIDEO_A_T2V=https://video-provider.example/a/text-to-video
VIDEO_A_I2V=https://video-provider.example/a/image-to-video
VIDEO_B_T2V=https://video-provider.example/b/text-to-video
VIDEO_B_I2V=https://video-provider.example/b/image-to-video
VIDEO_C_T2V=https://video-provider.example/c/text-to-video
VIDEO_C_I2V=https://video-provider.example/c/image-to-video

# Vídeo premium (operação longa) — base + modelo + nome do header de auth.
PREMIUM_VIDEO_BASE_URL=https://premium-video-provider.example/v1beta
PREMIUM_VIDEO_MODEL=premium-video-model
PREMIUM_VIDEO_AUTH_HEADER=x-api-key

# Voz — base + modelo de transcrição + nome do header de auth.
SPEECH_BASE_URL=https://voice-provider.example
SPEECH_MODEL=transcription-model
SPEECH_API_KEY_HEADER=x-api-key

# Rerank — base (o engine concatena /v1/rerank) + modelo.
RERANK_BASE_URL=https://rerank-provider.example
RERANK_MODEL=rerank-model

# Busca / leitura / pesquisa profunda — bases por slot + header de auth do alternativo.
SEARCH_PRIMARY_BASE=https://search-primary.example
SEARCH_ALT_BASE=https://search-alt.example
SEARCH_ALT_AUTH_HEADER=X-Subscription-Token
READER_BASE=https://reader.example
SEARCH_READ_BASE=https://search-reader.example
DEEPSEARCH_BASE=https://deepsearch-provider.example
DEEPSEARCH_MODEL=deepsearch-model

# Scraper de perfis sociais — base da API.
SCRAPER_BASE=https://scraper-provider.example
# Token compartilhado engine⇄console: protege /v1/admin/* (chaves de geração geridas no
# painel admin) + /internal/gen-keys (boot-fetch). Gerar: openssl rand -hex 32
ENGINE_ADMIN_TOKEN=
# Console interno p/ o boot-fetch do engine (default já resolve na rede do compose):
CONSOLE_INTERNAL_URL=http://console:8000

# ── MÍDIA (object storage S3 + ffmpeg-service) — DENTRO do stack do Reachyn ──
# Resolver por NOME de serviço na rede compartilhada, NÃO por IP fixo.
MEDIA_FFMPEG_URL=http://ffmpeg-service:7788
# Token compartilhado engine⇄ffmpeg-service (X-Service-Token). Gerar: openssl rand -hex 32 (AUD-008)
FFMPEG_SERVICE_TOKEN=
MEDIA_S3_ENDPOINT=http://object-storage:8000     # endpoint interno do servidor S3-compatível
MEDIA_S3_BUCKET=public
# Base pública de leitura da mídia (defina o host real do seu storage):
MEDIA_S3_PUBLIC_BASE=https://media-host.example
# Host público da mídia exposto ao front (Next.js): usado pra marcar "mídia nossa" na galeria.
NEXT_PUBLIC_MEDIA_HOST=media-host.example
# Credenciais S3: o servidor de object storage as DEFINE (vars de access key/secret no compose)
# e o cliente (console/ffmpeg via boto3) as USA — MESMOS valores. Gerar fortes; guardar fora do git.
S3_KEY=
S3_SECRET=

# ── Zernio (publish social white-label) — usado pelo console ──
ZERNIO_API_KEY=
