APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reachyn
# RBK-001: o RUNTIME deve conectar como reachyn_app (NOSUPERUSER/NOBYPASSRLS) para o RLS valer.
# NUNCA usar o owner/superuser aqui — o superuser fica só no scripts/migrate-prod.sh (migrations).
DB_USERNAME=reachyn_app
DB_PASSWORD=
# Senha usada SÓ na 1ª criação do role pela migração (ensure_reachyn_app_role), se ele não existir.
DB_APP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# AUD-007: cookie de sessão só por HTTPS em produção (atrás do Traefik/TLS).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Engine Go (geração) ──
ENGINE_URL=http://engine:8080
ENGINE_ADMIN_TOKEN=
STUDIO_URL=

# ── Provedor de voz (clonagem/dublagem no Studio) — white-label, base via env ──
# Sem default revelador no código: o endpoint real fica SÓ aqui.
VOICE_API_BASE=https://voice-provider.example
SPEECH_API_KEY=

# ── Object storage S3 (mídia) — host público vem do env, sem domínio no código ──
MEDIA_S3_ENDPOINT=http://object-storage:8000
MEDIA_S3_BUCKET=public
MEDIA_S3_PUBLIC_BASE=https://media-host.example
S3_KEY=
S3_SECRET=

# ── Publish social white-label ──
ZERNIO_API_KEY=

VITE_APP_NAME="${APP_NAME}"
